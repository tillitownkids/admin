generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Story {
  id              String   @id @default(uuid())
  topic           String   @default("")
  concept         String   @default("")
  storyOverview   String   @default("")
  teachLesson     String   @default("")
  episode_number  String
  generation_type String   @default("new")
  mode            String   @default("single")
  content         String
  generated_at    DateTime @default(now())
  status          String
  scripts         Script[]
}

model Script {
  id              String   @id @default(uuid())
  topic           String   @default("")
  episode_number  String
  generation_type String   @default("new")
  mode            String   @default("single")
  content         String   @default("{}")
  generated_at    DateTime @default(now())
  status          String
  storyId         String?
  story           Story?   @relation(fields: [storyId], references: [id])
}
