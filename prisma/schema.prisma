generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
}

model Story {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  topic             String?           @default("")
  episode_number    String
  generation_type   String?           @default("new")
  mode              String?           @default("single")
  content           String
  generated_at      DateTime          @default(now()) @db.Timestamptz(6)
  status            String
  production_stage  String            @default("story")
  previous_story_id String?           @db.Uuid
  EpisodeLocation   EpisodeLocation[]
  Scene             Scene[]
  Story             Story?            @relation("StoryToStory", fields: [previous_story_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_Story       Story[]           @relation("StoryToStory")
  StoryCharacter    StoryCharacter[]
}

model Script {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  topic           String?  @default("")
  episode_number  String
  generation_type String?  @default("new")
  mode            String?  @default("single")
  content         String
  generated_at    DateTime @default(now()) @db.Timestamptz(6)
  status          String
}

model Beat {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scene_id    String   @db.Uuid
  beat_number Int
  action      String   @default("")
  camera      String   @default("")
  motion      String   @default("")
  dialogue    String   @default("")
  sfx         String   @default("")
  order_index Int      @default(0)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)
  Scene       Scene    @relation(fields: [scene_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([scene_id, beat_number])
}

model Character {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String
  description         String           @default("")
  reference_image_url String?
  created_at          DateTime         @default(now()) @db.Timestamptz(6)
  updated_at          DateTime         @default(now()) @db.Timestamptz(6)
  SceneCharacter      SceneCharacter[]
  StoryCharacter      StoryCharacter[]
}

model EpisodeLocation {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  story_id             String   @db.Uuid
  location_id          String   @db.Uuid
  order_index          Int      @default(0)
  stylesheet_prompt    String   @default("")
  stylesheet_image_url String?
  status               String   @default("pending")
  created_at           DateTime @default(now()) @db.Timestamptz(6)
  updated_at           DateTime @default(now()) @db.Timestamptz(6)
  Location             Location @relation(fields: [location_id], references: [id], onUpdate: NoAction)
  Story                Story    @relation(fields: [story_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Scene                Scene[]

  @@unique([story_id, location_id])
}

model ImageAsset {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_type   String
  owner_id     String   @db.Uuid
  storage_path String
  public_url   String
  source       String
  prompt_used  String?
  is_selected  Boolean  @default(false)
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  @@index([owner_type, owner_id], map: "idx_image_asset_owner")
}

model Location {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String
  description         String            @default("")
  reference_image_url String?
  created_at          DateTime          @default(now()) @db.Timestamptz(6)
  updated_at          DateTime          @default(now()) @db.Timestamptz(6)
  EpisodeLocation     EpisodeLocation[]
}

model Scene {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  episode_location_id  String           @db.Uuid
  scene_number         Int
  description          String           @default("")
  storyboard_prompt    String           @default("")
  storyboard_image_url String?
  storyboard_status    String           @default("pending")
  beats_status         String           @default("pending")
  order_index          Int              @default(0)
  created_at           DateTime         @default(now()) @db.Timestamptz(6)
  updated_at           DateTime         @default(now()) @db.Timestamptz(6)
  story_id             String?          @db.Uuid
  Beat                 Beat[]
  EpisodeLocation      EpisodeLocation  @relation(fields: [episode_location_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Story                Story?           @relation(fields: [story_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  SceneCharacter       SceneCharacter[]

  @@unique([episode_location_id, scene_number])
}

model SceneCharacter {
  scene_id     String    @db.Uuid
  character_id String    @db.Uuid
  Character    Character @relation(fields: [character_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Scene        Scene     @relation(fields: [scene_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([scene_id, character_id])
}

model StoryCharacter {
  story_id     String    @db.Uuid
  character_id String    @db.Uuid
  Character    Character @relation(fields: [character_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Story        Story     @relation(fields: [story_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([story_id, character_id])
}
